# Environment files and server secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
**/*firebase-adminsdk*.json
**/*service-account*.json
**/serviceAccountKey.json
**/google-credentials.json
**/*private-key*.json
**/*.pem
**/*.p8
**/*.p12
**/*.key
**/*.keystore
**/*.jks
**/*.mobileprovision
**/*.pfx

# Laravel dependencies and runtime
**/vendor/
**/node_modules/
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/bootstrap/cache/*.php
backend/public/storage

# Flutter / Android / iOS generated outputs
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/.gradle/
**/Pods/
**/DerivedData/
**/xcuserdata/
mobile/android/local.properties
mobile/android/key.properties
**/*.apk
**/*.aab
**/*.ipa
**/*.dSYM/
**/dist/

# Build artifacts, backups and temporary files
setup/output/*.zip
setup/output/*.sha256
setup/output/*BUILD_INFO*.json
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.sql
**/*.sql.gz
**/*.bak
**/*.tmp
**/.idea/
**/.vscode/
